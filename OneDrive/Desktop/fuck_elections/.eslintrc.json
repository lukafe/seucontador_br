{
  "root": true,
  "env": {
    "es2021": true,
    "node": true,
    "mocha": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "ignorePatterns": ["/artifacts/**", "/cache/**", "/typechain-types/**", "/node_modules/**"],
  "rules": {
    "@typescript-eslint/explicit-module-boundary-types": "off"
  }
} 